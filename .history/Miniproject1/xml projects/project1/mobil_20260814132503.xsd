<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="MobileShowroom">

        <xs:complexType>

            <xs:sequence>

                <xs:element name="Mobile" maxOccurs="50">

                    <xs:complexType>

                        <xs:sequence>

                            <xs:element name="ModelName"
                                        type="xs:string"/>

                            <xs:element name="ModelID"
                                        type="xs:string"/>

                            <xs:element name="Brand"
                                        type="xs:string"/>

                            <xs:element name="Price"
                                        type="xs:decimal"/>

                            <xs:element name="Color"
                                        type="xs:string"/>

                            <xs:element name="SIMSize">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="Normal"/>
                                        <xs:enumeration value="Micro"/>
                                        <xs:enumeration value="Nano"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <xs:element name="Memory"
                                        type="xs:string"/>

                            <xs:element name="Camera">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="Yes"/>
                                        <xs:enumeration value="No"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <xs:element name="TouchScreen">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="Yes"/>
                                        <xs:enumeration value="No"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                            <xs:element name="NoSold"
                                        type="xs:positiveInteger"/>

                            <xs:element name="storeName">
                                <xs:simpleType>
                                    <xs:restriction base="xs:string">
                                        <xs:enumeration value="store1"/>
                                        <xs:enumeration value="store2"/>
                                        <xs:enumeration value="store3"/>
                                    </xs:restriction>
                                </xs:simpleType>
                            </xs:element>

                        </xs:sequence>

                    </xs:complexType>

                </xs:element>

            </xs:sequence>

        </xs:complexType>

    </xs:element>

</xs:schema>