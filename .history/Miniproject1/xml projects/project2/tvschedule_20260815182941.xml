<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE TVSCHEDULE [
    <!ELEMENT TVSCHEDULE (CHANNEL+)>
    <!ELEMENT CHANNEL (BANNER, DAY+)>
    <!ELEMENT BANNER (#PCDATA)>
    <!ELEMENT DAY (HOLIDAY | PROGRAMSLOT)+>
    <!ELEMENT HOLIDAY (#PCDATA)>
    <!ELEMENT DATE (#PCDATA)>
    <!ELEMENT PROGRAMSLOT (TIME, TITLE, DESCRIPTION?)>
    <!ELEMENT TIME (#PCDATA)>
    <!ELEMENT TITLE (#PCDATA)>
    <!ELEMENT DESCRIPTION (#PCDATA)>

    <!ATTLIST TVSCHEDULE
        NAME CDATA #REQUIRED>

    <!ATTLIST CHANNEL
        CHAN CDATA #REQUIRED>

    <!ATTLIST PROGRAMSLOT
        VTR CDATA #IMPLIED>

    <!ATTLIST TITLE
        RATING CDATA #IMPLIED>
]>

<TVSCHEDULE NAME="Weekly TV Schedule">

    <CHANNEL CHAN="101">

        <BANNER>Entertainment Channel</BANNER>

        <DAY>
            <DATE>Monday</DATE>

            <PROGRAMSLOT VTR="Yes">
                <TIME>09:00 AM</TIME>
                <TITLE RATING="PG">Morning Show</TITLE>
                <DESCRIPTION>Daily entertainment program</DESCRIPTION>
            </PROGRAMSLOT>

            <PROGRAMSLOT>
                <TIME>07:00 PM</TIME>
                <TITLE RATING="U">News</TITLE>
            </PROGRAMSLOT>
        </DAY>

        <DAY>
            <HOLIDAY>Sunday</HOLIDAY>
        </DAY>

    </CHANNEL>

</TVSCHEDULE>