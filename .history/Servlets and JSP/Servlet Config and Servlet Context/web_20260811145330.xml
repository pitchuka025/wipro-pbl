<?xml version="1.0" encoding="UTF-8"?>

<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         version="3.1">

    <context-param>
        <param-name>collegeName</param-name>
        <param-value>ABC College</param-value>
    </context-param>

    <servlet>
        <servlet-name>ConfigContextDemo</servlet-name>
        <servlet-class>ConfigContextDemo</servlet-class>

        <init-param>
            <param-name>studentName</param-name>
            <param-value>Rupasri</param-value>
        </init-param>
    </servlet>

    <servlet-mapping>
        <servlet-name>ConfigContextDemo</servlet-name>
        <url-pattern>/demo</url-pattern>
    </servlet-mapping>

</web-app>